{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/showdex/(.*)", "dest": "/showdex/$1" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/config/(.*)", "dest": "/config/$1" },
    { "src": "/fx/(.*)", "dest": "/fx/$1" },
    { "src": "/sprites/(.*)", "dest": "/sprites/$1" },
    { "src": "/audio/(.*)", "dest": "/audio/$1" },
    { "src": "/(.*)", "dest": "/play.pokemonshowdown.com/$1" }
  ]
}
